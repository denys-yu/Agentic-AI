# Скопіюй цей файл у .env і встав свій ключ. .env у git не потрапляє.

# Ключ OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Швидка й дешева модель (GPT-6 Luna): $0.10 / $0.50 за 1M токенів
MODEL_FAST=gpt-6-luna

# Розумна модель (GPT-6.1 Sol): $2 / $10 за 1M токенів
MODEL_SMART=gpt-6.1-sol
